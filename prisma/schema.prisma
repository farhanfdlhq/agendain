generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Destinasi {
  id           Int     @id @default(autoincrement())
  nama         String
  namaEn       String?
  slug         String  @unique
  negara       String
  deskripsi    String  @db.Text
  deskripsiEn  String? @db.Text
  foto         String
  bahasa       String?
  matauang     String?
  waktuTerbaik String?
  infoVisa     String? @db.Text
  openTrips OpenTrip[]
}

model OpenTrip {
  id            Int       @id @default(autoincrement())
  nama          String
  namaEn        String?
  slug          String    @unique
  deskripsi     String    @db.Text
  deskripsiEn   String?   @db.Text
  harga         Decimal   @db.Decimal(15, 2)
  durasi        Int
  destinasiId   Int
  destinasi     Destinasi @relation(fields: [destinasiId], references: [id])
  foto          Json
  itinerary     Json
  itineraryEn         Json?
  fasilitas           Json
  fasilitasEn         Json?
  termasuk            Json
  termasukEn          Json?
  tidakTermasuk       Json
  tidakTermasukEn     Json?
  informasiPenting    Json?
  informasiPentingEn  Json?
  kebijakanPembatalan Json?
  kebijakanPembatalanEn Json?
  fileDokumen         Json?
  // Digantikan akomodasi + penerbangan di UI. Kolomnya sengaja DIPERTAHANKAN
  // agar isi lama paket yang sudah terbit tidak hilang.
  opsiPenjemputan     Json?
  opsiPenjemputanEn   Json?
  // Tanggal mulai trip. Nullable: paket lama & paket "jadwal fleksibel"
  // tidak punya tanggal pasti, dan halaman depan jatuh ke teks fleksibel.
  tanggalKeberangkatan DateTime?
  // Kuota kursi. `kursiTerisi` diisi manual admin supaya booking lewat
  // WhatsApp/offline ikut terhitung, bukan hanya yang masuk tabel Booking.
  kuota               Int?
  kursiTerisi         Int       @default(0)
  akomodasi           Json?
  akomodasiEn         Json?
  penerbangan         Json?
  penerbanganEn       Json?
  status              String    @default("draft")
  label               String?
  bookings            Booking[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([destinasiId])
}

model Booking {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String
  noWa      String
  openTripId Int
  openTrip OpenTrip @relation(fields: [openTripId], references: [id])
  tanggal   DateTime
  jumlahPax Int
  total     Decimal  @db.Decimal(15, 2)
  status    String   @default("pending")
  catatan   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model PrivateTrip {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String
  noWa      String
  destinasi String
  tanggal   DateTime
  jumlahPax Int
  budget    String
  catatan   String?  @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  nama      String
  role      String   @default("admin")
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Setting {
  key   String @id
  value String @db.Text
}

model PrivateTripPackage {
  id          Int      @id @default(autoincrement())
  title       String
  subtitle    String
  image       String
  locationTab String
  chips       Json
  features    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String   // "login.success" | "login.failed" | "user.create" | "user.update" | "user.delete" | "role.update" | "profile.update" | "profile.password_change" | "profile.avatar_change"
  actorId    Int?     // null bila pelaku tak dikenal (mis. login gagal email tak terdaftar)
  actorEmail String?  // email yang dicoba / pelaku
  targetType String?  // "AdminUser" | "Setting"
  targetId   String?  // id entitas terdampak (String agar seragam Int/key)
  detail     String?  @db.Text // JSON string: { reason }, { roleFrom, roleTo }, dst.
  ip         String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
}

model BlogCategory {
  id        Int        @id @default(autoincrement())
  nama      String
  namaEn    String?
  slug      String     @unique
  posts     BlogPost[]
  createdAt DateTime   @default(now())
}

model BlogPost {
  id              Int           @id @default(autoincrement())
  title           String
  titleEn         String?
  slug            String        @unique
  excerpt         String        @db.Text
  excerptEn       String?       @db.Text
  content         String        @db.LongText
  contentEn       String?       @db.LongText
  thumbnail       String
  categoryId      Int
  category        BlogCategory  @relation(fields: [categoryId], references: [id])
  tags            Json          // array string ["travel","eropa"]
  status          String        @default("draft") // "draft" | "published"
  metaTitle       String?
  metaDescription String?       @db.Text
  ogImage         String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([slug])
}

model PaymentAccount {
  id        Int       @id @default(autoincrement())
  label     String    // "WISE EUR", "BCA IDR" — yang dibaca admin di dropdown
  bank      String    // "WISE", "BCA", "Mandiri"
  atasNama  String?
  nomor     String?
  bicSwift  String?
  iban      String?
  isDefault Boolean   @default(false)
  // Hapus = nonaktifkan, JANGAN hapus baris: invoice lama merujuk ke sini.
  aktif     Boolean   @default(true)
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([aktif])
}

model Invoice {
  id           Int      @id @default(autoincrement())
  nomor        String   @unique // INV/2026/08/0001
  token        String   @unique // tautan publik, acak
  bahasa       String   @default("id") // id | en
  mataUang     String   @default("IDR") // IDR | EUR

  klienNama    String
  klienEmail   String?
  klienTelepon String?
  klienAlamat  String?  @db.Text

  judul        String?
  tanggal      DateTime
  jatuhTempo   DateTime?

  items        Json // [{ deskripsi, qty, harga }]

  // Angka DIBEKUKAN saat terbit — invoice lama tidak boleh ikut berubah bila
  // persen pajak di Pengaturan diubah kemudian.
  subtotal     Decimal  @db.Decimal(15, 2)
  pajakLabel   String?
  pajakPersen  Decimal  @default(0) @db.Decimal(5, 2)
  pajakNominal Decimal  @default(0) @db.Decimal(15, 2)
  total        Decimal  @db.Decimal(15, 2)

  kurs         Decimal? @db.Decimal(15, 2)
  totalPadanan Decimal? @db.Decimal(15, 2)

  catatan      String?  @db.Text
  status       String   @default("draft") // draft | terkirim | lunas | batal
  lunasAt      DateTime?

  paymentAccountId Int?
  paymentAccount   PaymentAccount? @relation(fields: [paymentAccountId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Itinerary {
  id           Int      @id @default(autoincrement())
  token        String   @unique          // tautan publik acak (randomBytes base64url)
  bahasa       String   @default("id")   // id | en — hanya label dokumen yang beralih
  judul        String                    // "Itinerary Keluarga Jhonson"
  klienNama    String
  klienNegara  String?
  klienTelepon String?
  klienEmail   String?
  tanggalDok   DateTime                  // "Date:" di kop dokumen
  // [{ tanggal, items:[{ mulai, selesai, lokasi, catatan, gambar }] }]
  hari         Json
  catatan      String?  @db.Text
  status       String   @default("draft") // draft | published | archived
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
