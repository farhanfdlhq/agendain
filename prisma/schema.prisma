generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Destinasi {
  id           Int     @id @default(autoincrement())
  nama         String
  slug         String  @unique
  negara       String
  deskripsi    String  @db.Text
  foto         String
  bahasa       String?
  matauang     String?
  waktuTerbaik String?
  infoVisa     String? @db.Text
  openTrips OpenTrip[]
}

model OpenTrip {
  id            Int       @id @default(autoincrement())
  nama          String
  slug          String    @unique
  deskripsi     String    @db.Text
  harga         Decimal   @db.Decimal(15, 2)
  durasi        Int
  destinasiId   Int
  destinasi     Destinasi @relation(fields: [destinasiId], references: [id])
  foto          Json
  itinerary     Json
  fasilitas           Json
  termasuk            Json
  tidakTermasuk       Json
  informasiPenting    Json?
  kebijakanPembatalan Json?
  fileDokumen         Json?
  opsiPenjemputan     Json?
  status              String    @default("draft")
  label               String?
  bookings            Booking[]
  inquiries           Inquiry[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([destinasiId])
}

model Booking {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String
  noWa      String
  openTripId Int
  openTrip OpenTrip @relation(fields: [openTripId], references: [id])
  tanggal   DateTime
  jumlahPax Int
  total     Decimal  @db.Decimal(15, 2)
  status    String   @default("pending")
  catatan   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model Inquiry {
  id           Int      @id @default(autoincrement())
  nama         String
  email        String
  noWa         String?
  pesan        String   @db.Text
  openTripId Int?
  openTrip OpenTrip? @relation(fields: [openTripId], references: [id])
  sudahDibalas Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([sudahDibalas, createdAt])
}

model PrivateTrip {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String
  noWa      String
  destinasi String
  tanggal   DateTime
  jumlahPax Int
  budget    String
  catatan   String?  @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  nama      String
  role      String   @default("admin")
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Setting {
  key   String @id
  value String @db.Text
}

model PrivateTripPackage {
  id          Int      @id @default(autoincrement())
  title       String
  subtitle    String
  image       String
  locationTab String
  chips       Json
  features    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String   // "login.success" | "login.failed" | "user.create" | "user.update" | "user.delete" | "role.update" | "profile.update" | "profile.password_change" | "profile.avatar_change"
  actorId    Int?     // null bila pelaku tak dikenal (mis. login gagal email tak terdaftar)
  actorEmail String?  // email yang dicoba / pelaku
  targetType String?  // "AdminUser" | "Setting"
  targetId   String?  // id entitas terdampak (String agar seragam Int/key)
  detail     String?  @db.Text // JSON string: { reason }, { roleFrom, roleTo }, dst.
  ip         String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
}
